# Paystack public key (safe for frontend use). Get yours from the Paystack
# dashboard: Settings > API Keys & Webhooks. Use a pk_test_ key while testing,
# swap to your pk_live_ key only once a server-side verification step exists
# (see the note at the top of src/lib/paystack.ts before going live).
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
